{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["server/**/*.ts", "api/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "data/**/*.json", "vite.config.ts"]
}
