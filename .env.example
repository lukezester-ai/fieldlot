# API (по подразбиране 8789)
FIELDLOT_API_PORT=8789

# LLM — поне един от блоковете
# Чат + AI агент (tools) — Mistral или OpenAI (Ollama = само текст, без действия)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
# Vision (crop photo classification): pixtral-12b-2409 or mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# Admin панел — /admin.html
FIELDLOT_ADMIN_SECRET=

# Само „продава“ без „купува“ (1 = филтър)
FIELDLOT_SALES_ONLY=0
# FIELDLOT_AGENT_DISABLED=1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Имейл за формата (Resend)
# RESEND_API_KEY=
# RESEND_FROM=Fieldlot <onboarding@yourdomain.com>
FIELDLOT_INBOX_EMAIL=info@agrinexus.eu
# MAIL_TO=info@agrinexus.eu

# Cron (Vercel) — опресняване на борсови цени 06:00 UTC
# Required in production. Cron endpoints deny all requests when it is missing.
# CRON_SECRET=your-long-random-secret

# Локален лог на заявки
# FIELDLOT_STORE_LEADS=1

# ScraperAPI sources are expensive. Keep disabled unless running a controlled manual sync.
# SCRAPER_API_KEY=
# SCRAPERAPI_KEY=
FIELDLOT_ENABLE_SCRAPERAPI_SYNC=0

# Firebase (Vite inlines VITE_* at build time — required for auth/dashboard/catalog)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional: persist listing snapshot across Vercel instances
# Preferred: Vercel Blob store — set BLOB_READ_WRITE_TOKEN (Vercel storage integration)
# BLOB_READ_WRITE_TOKEN=
# Fallback: custom PUT + public GET URL
# FIELDLOT_SNAPSHOT_PUT_URL=
# FIELDLOT_SNAPSHOT_URL=
# FIELDLOT_SNAPSHOT_TOKEN=

# FIELDLOT_E2E_EMAIL=
# FIELDLOT_E2E_PASSWORD=
