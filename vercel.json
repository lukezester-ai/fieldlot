{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"installCommand": "npm install --no-audit --no-fund",
	"framework": null,
	"rewrites": [
		{ "source": "/catalog", "destination": "/catalog.html" },
		{ "source": "/admin", "destination": "/admin.html" },
		{ "source": "/logistics", "destination": "/logistics.html" }
	],
	"functions": {
		"api/**/*.ts": {
			"maxDuration": 60
		}
	},
	"crons": [
		{
			"path": "/api/cron/exchange-prices",
			"schedule": "0 6 * * *"
		},
		{
			"path": "/api/cron/sync-listings",
			"schedule": "0 */4 * * *"
		}
	]
}
