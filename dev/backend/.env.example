# FIELDLOT FastAPI backend
DATABASE_URL=sqlite:///./fieldlot.db
# PostgreSQL (production): postgresql+psycopg2://user:pass@host:5432/fieldlot

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Optional: OpenAI for real crop analysis (phase 2)
# OPENAI_API_KEY=
