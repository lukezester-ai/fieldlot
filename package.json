{
	"name": "fieldlot",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "concurrently -k \"vite\" \"tsx watch server/dev-api.ts\"",
		"dev:full": "concurrently -k \"vite\" \"tsx watch server/dev-api.ts\" \"npm run backend:dev\"",
		"backend:dev": "node scripts/run-backend.mjs",
		"backend:seed": "node scripts/run-backend.mjs --seed-only",
		"build": "node scripts/copy-data-to-public.mjs && node scripts/sync-images-from-manifest.mjs && vite build",
		"sync:listings": "node scripts/sync-gov-listings.mjs",
		"sync:images": "node scripts/fix-crop-images.mjs && node scripts/sync-images-from-manifest.mjs",
		"fetch:exchange": "node scripts/fetch-exchange-prices.mjs",
		"preview": "concurrently -k \"vite preview --port 5174 --strictPort\" \"tsx server/dev-api.ts\"",
		"typecheck": "tsc --noEmit",
		"verify": "node scripts/verify-fieldlot.mjs",
		"test:unit": "tsx --test server/cron-auth.test.ts server/listings-data.test.ts server/admin-auth.test.ts server/admin-handler.test.ts server/fieldlot-semantic-rag.test.ts server/api-cors.test.ts server/moderation-store.test.ts",
		"test": "npm run typecheck && npm run test:unit && node scripts/smoke-api.mjs",
		"test:e2e": "playwright test",
		"test:backend": "node scripts/smoke-backend.mjs",
		"build:with-listings": "npm run sync:listings && node scripts/copy-data-to-public.mjs && node scripts/sync-images-from-manifest.mjs && vite build"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.3.4",
		"@playwright/test": "^1.55.1",
		"@types/node": "^22.10.1",
		"@vercel/node": "^5.5.28",
		"concurrently": "^9.1.2",
		"dotenv": "^16.4.7",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vite": "^7.1.12"
	},
	"dependencies": {
		"@capacitor/android": "^8.3.4",
		"@capacitor/core": "^8.3.4",
		"@vercel/blob": "^2.0.0",
		"cheerio": "^1.2.0",
		"duck-duck-scrape": "^2.2.7",
		"firebase": "^12.13.0",
		"pdf-parse": "^2.4.5"
	}
}
